<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SiCoFa.Presentacion</RootNamespace>
    <AssemblyName>SiCoFa.Presentacion</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MyType>WindowsForms</MyType>
    <!-- Indica que el punto de entrada es tu módulo de inicio personalizado -->
    <StartupObject>SiCoFa.Presentacion.ModInicio</StartupObject>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiCoFa.Negocio\Negocio.vbproj" />
    <ProjectReference Include="..\SiCoFa.Entidades\Entidades.vbproj" />
    <ProjectReference Include="..\SiCoFa.Datos\Datos.vbproj" />
    <ProjectReference Include="..\ServiciosExternos\ServiciosExternos.vbproj" />
    <ProjectReference Include="..\Vecho\Vecho.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ReportingServices.ReportViewerControl.Winforms" Version="150.1652.0" />
  </ItemGroup>
</Project>