<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>SiCoFa.ServiciosExternos</RootNamespace>
    <AssemblyName>SiCoFa.ServiciosExternos</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="iTextSharp" Version="5.5.13.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiCoFa.Entidades\Entidades.vbproj" />
    <ProjectReference Include="..\Vecho\Vecho.vbproj" />
  </ItemGroup>
</Project>