<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>SiCoFa.Negocio</RootNamespace>
    <AssemblyName>SiCoFa.Negocio</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiCoFa.Entidades\Entidades.vbproj" />
    <ProjectReference Include="..\SiCoFa.Datos\Datos.vbproj" />
    <ProjectReference Include="..\SiCoFa.ServiciosExternos.WCF\ServiciosExternosWCF.csproj" />
    <ProjectReference Include="..\Vecho\Vecho.vbproj" />
    <ProjectReference Include="..\ServiciosExternos\ServiciosExternos.vbproj" />
  </ItemGroup>
</Project>